generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Profile {
  id              String    @id @default(cuid())
  steamId         String    @unique
  personaName     String?
  avatarUrl       String?
  profileUrl      String?
  currency        String    @default("USD")
  faceitId        String?
  faceitNickname  String?
  faceitUrl       String?
  faceitLevel     Int?
  faceitElo       Int?
  faceitFound     Boolean   @default(false)
  faceitFetchedAt DateTime?
  leetifyId       String?
  leetifyName     String?
  leetifyUrl      String?
  leetifyRating   Float?
  leetifyFound    Boolean   @default(false)
  lastSyncedAt    DateTime?
  lastError       String?
  syncing         Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  items     InventoryItem[]
  snapshots PortfolioSnapshot[]
}

model InventoryItem {
  id              String   @id @default(cuid())
  profileId       String
  assetId         String
  classId         String
  instanceId      String?
  marketHashName  String
  name            String
  iconUrl         String?
  exterior        String?
  floatValue      Float?
  paintSeed       Int?
  paintIndex      Int?
  stickers        String?  // JSON array
  inspectLink     String?
  steamPrice      Float?
  buffPrice       Float?
  tradable        Boolean  @default(true)
  marketable      Boolean  @default(true)
  rarity          String?
  type            String?
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, assetId])
  @@index([profileId])
  @@index([marketHashName])
}

model PriceCache {
  id             String    @id @default(cuid())
  marketHashName String
  currency       String    @default("USD")
  steamPrice     Float?
  buffPrice      Float?
  steamFetchedAt DateTime?
  buffFetchedAt  DateTime?
  updatedAt      DateTime  @updatedAt
  createdAt      DateTime  @default(now())

  @@unique([marketHashName, currency])
  @@index([currency])
}

model PortfolioSnapshot {
  id         String   @id @default(cuid())
  profileId  String
  currency   String   @default("USD")
  itemCount  Int
  totalSteam Float
  totalBuff  Float
  createdAt  DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, createdAt])
  @@index([profileId, currency, createdAt])
}

model CatalogMeta {
  id        String   @id @default("csgotrader-steam")
  fetchedAt DateTime
  itemCount Int      @default(0)
}
