# Pooled connection (Supabase Transaction pooler, port 6543). Used by the Next.js app.
# Example: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Direct connection (port 5432). Required for prisma migrate deploy / migrate dev.
# Example: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# Or Session mode / direct db.*.supabase.co:5432
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

SYNC_COOLDOWN_MS=180000

# Optional. Required to allow force sync via header x-sync-force-secret (or Bearer).
# Public UI does not expose Force; omit on Vercel unless you need admin override.
# SYNC_FORCE_SECRET=

# Upstash Redis (recommended on Vercel). Without these, rate limits are in-memory per instance.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional. Without this, FACEIT level comes from Leetify's public API.
# FACEIT_API_KEY=

# Preferred remote float/pattern provider: self-hosted CSGOFloat-compatible
# inspect service (GET {url}?url={inspectLink}). Public CSFloat/CSGOFloat APIs
# are currently blocked by Valve — run your own bot(s).
#
# Needed for classic S/A/D links. Steam's public inventory usually only gives
# unresolved %propid% placeholders; without a GC bot (or Steamwebapi below),
# weapon floats will stay empty. On Vercel v1 this is omitted (degraded floats).
# INSPECT_API_URL=http://127.0.0.1:80
# INSPECT_API_KEY=
# INSPECT_API_MAX_FETCHES=120
# INSPECT_API_DELAY_MS=1100

# Steamwebapi key — optional last-resort float enricher after local decode
# and INSPECT_API_URL. Uses /steam/api/inventory (certificate floats) +
# /steam/api/float/assets gap-fill. Legacy S/A/D inspects return HTTP 406.
# Omit on Vercel for now (degrade floats). Get a key at https://www.steamwebapi.com
# STEAMWEBAPI_KEY=
