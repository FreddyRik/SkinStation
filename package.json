{
  "name": "skinstation",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "build:vercel": "prisma migrate deploy && next build",
    "start": "next start -p 3001",
    "lint": "next lint",
    "test:api-security": "tsx scripts/test-api-security.mts",
